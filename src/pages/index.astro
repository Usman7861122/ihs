---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../islands/Hero';
import About from '../islands/About';
import WhatWeDo from '../islands/WhatWeDo';
import Showcase from '../islands/Showcase';
import Rankings from '../islands/Rankings';
import AiOverviews from '../islands/AiOverviews';
import EhrIntegrations from '../islands/EhrIntegrations';
import Mission from '../islands/Mission';
import { hero } from '../data/hero';
import { about } from '../data/about';
import { whatWeDo } from '../data/whatWeDo';
import { showcase } from '../data/showcase';
import { rankings } from '../data/rankings';
import { aiOverviews } from '../data/aiOverviews';
import { ehr } from '../data/ehr';
import { mission } from '../data/mission';
---

<BaseLayout title="IHS">
  <main>
    <Hero client:load {...hero} />
    <About client:visible {...about} />
    <WhatWeDo client:visible {...whatWeDo} />
    <Showcase client:visible {...showcase} />
    <Rankings client:visible {...rankings} />
    <EhrIntegrations client:visible {...ehr} />
    <Mission client:visible {...mission} />
    <AiOverviews client:visible {...aiOverviews} />
  </main>
</BaseLayout>
