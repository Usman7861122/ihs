---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerHero from '../components/sections/InnerHero.astro';
import Reveal from '../components/ui/Reveal.astro';
import { joinPage as j } from '../data/joinPage';
---

<BaseLayout title="Join Iron Health Solutions | Careers" description="Build your career with Iron Health Solutions. See open Account Executive, SDR and Web Developer roles.">
  <main>
    <InnerHero
      {...j.hero}
      crumbs={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about-us' }, { label: 'Join us' }]}
      buttons={[
        { label: 'See open roles', href: '#positions' },
        { label: 'Get Started', href: '/contact/', variant: 'glass' },
      ]}
    />

    <!-- Intro -->
    <section class="relative -mt-12 rounded-t-[44px] bg-[#fbf3ec] px-2.5 py-[88px] text-ink md:py-[120px]">
      <div class="mx-auto grid max-w-[1100px] items-start gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
        <div data-reveal>
          <p class="flex items-center gap-3 text-[14px] leading-none font-semibold tracking-[3px] text-brand uppercase">
            <span aria-hidden="true" class="h-0.5 w-10 bg-brand"></span>{j.intro.eyebrow}
          </p>
          <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">
            {j.intro.title} <span class="font-(family-name:--font-accent) font-normal text-brand italic">{j.intro.accent}</span>
          </h2>
        </div>
        <div class="flex flex-col gap-5 text-[17px] leading-8 text-black/65" data-reveal style="--reveal-delay:120ms">
          {j.intro.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- Perks -->
    <section class="relative -mt-12 rounded-t-[44px] bg-[#181310] px-2.5 py-[88px] text-white md:py-[120px]">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(55%_60%_at_20%_0%,rgba(201,111,58,0.2),transparent_70%)]"></div>
      <div class="relative mx-auto max-w-[1100px]">
        <div class="max-w-[640px]" data-reveal>
          <p class="flex items-center gap-3 text-[14px] leading-none font-semibold tracking-[3px] text-brand-light uppercase">
            <span aria-hidden="true" class="h-0.5 w-10 bg-brand"></span>{j.perks.eyebrow}
          </p>
          <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">
            {j.perks.title} <span class="font-(family-name:--font-accent) font-normal text-brand-light italic">{j.perks.accent}</span>
          </h2>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            j.perks.items.map((it, i) => (
              <div data-reveal style={`--reveal-delay:${(i % 3) * 100}ms`} class="group relative overflow-hidden rounded-3xl border border-white/10 bg-linear-to-b from-white/[0.07] to-white/[0.02] p-7 transition-all duration-500 hover:-translate-y-1 hover:border-brand-light/40">
                <span class="absolute inset-x-7 top-0 h-px bg-linear-to-r from-transparent via-brand-light to-transparent opacity-60"></span>
                <span aria-hidden="true" class="font-(family-name:--font-accent) text-3xl text-brand-light/80 italic">0{i + 1}</span>
                <h3 class="mt-5 text-[22px] leading-tight font-medium">{it.title}</h3>
                <p class="mt-3 text-[15px] leading-7 text-white/60">{it.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Open positions -->
    <section id="positions" class="relative -mt-12 scroll-mt-(--header-h) rounded-t-[44px] bg-[#fbf3ec] px-2.5 py-[88px] text-ink md:py-[120px]">
      <div class="mx-auto max-w-[900px]">
        <div class="text-center" data-reveal>
          <p class="text-[14px] leading-none font-semibold tracking-[3px] text-brand uppercase">{j.jobs.eyebrow}</p>
          <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">
            {j.jobs.title} <span class="font-(family-name:--font-accent) font-normal text-brand italic">{j.jobs.accent}</span>
          </h2>
          <p class="mx-auto mt-4 max-w-[520px] text-[17px] leading-8 text-black/60">{j.jobs.text}</p>
        </div>
        <ul class="mt-12 flex flex-col gap-3">
          {
            j.jobs.list.map((r, i) => (
              <li data-reveal style={`--reveal-delay:${i * 60}ms`}>
                <a href={j.jobs.apply.href} class="group flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-black/10 bg-white px-6 py-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-brand hover:shadow-[0_20px_50px_-30px_rgba(201,111,58,0.7)]">
                  <div>
                    <h3 class="text-[20px] font-medium transition-colors group-hover:text-brand">{r.title}</h3>
                    <p class="mt-1 text-[15px] text-black/55">{r.place}</p>
                  </div>
                  <div class="flex items-center gap-4">
                    <span class="rounded-full bg-brand/10 px-3.5 py-1 text-[13px] font-medium text-brand-deep">{r.type}</span>
                    <span class="btn btn-outline btn-sm"><span class="btn-label">{j.jobs.apply.label}</span><span class="btn-icon"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Hiring steps -->
    <section class="relative -mt-12 rounded-t-[44px] bg-[#181310] px-2.5 py-[88px] text-white md:py-[120px]">
      <div class="mx-auto max-w-[1100px]">
        <div class="max-w-[560px]" data-reveal>
          <p class="flex items-center gap-3 text-[14px] leading-none font-semibold tracking-[3px] text-brand-light uppercase">
            <span aria-hidden="true" class="h-0.5 w-10 bg-brand"></span>{j.steps.eyebrow}
          </p>
          <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">
            {j.steps.title} <span class="font-(family-name:--font-accent) font-normal text-brand-light italic">{j.steps.accent}</span>
          </h2>
        </div>
        <ol class="mt-12 grid gap-5 md:grid-cols-3">
          {
            j.steps.items.map((st, i) => (
              <li data-reveal style={`--reveal-delay:${i * 110}ms`} class="group relative overflow-hidden rounded-3xl border border-white/10 bg-linear-to-b from-white/[0.07] to-white/[0.02] p-7 pb-8 transition-all duration-500 hover:-translate-y-1.5 hover:border-brand-light/50">
                <span aria-hidden="true" class="pointer-events-none absolute -top-4 -right-1 font-(family-name:--font-accent) text-[120px] leading-none text-white/[0.05] italic transition-colors duration-500 group-hover:text-brand/20">{st.n}</span>
                <span class="relative flex size-12 items-center justify-center rounded-full bg-brand font-(family-name:--font-accent) text-xl text-white shadow-[0_10px_30px_-8px_rgba(201,111,58,0.8)]">{st.n}</span>
                <h3 class="relative mt-8 text-[22px] leading-tight font-medium">{st.title}</h3>
                <p class="relative mt-3 text-[15px] leading-7 text-white/60">{st.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
    <Reveal />
  </main>
</BaseLayout>
