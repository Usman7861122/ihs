---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerHero from '../components/sections/InnerHero.astro';
import Reveal from '../components/ui/Reveal.astro';
import PortfolioGrid from '../islands/PortfolioGrid';
import { portfolio as o } from '../data/portfolio';
---

<BaseLayout title={o.seo.title} description={o.seo.description}>
  <main>
    <InnerHero
      {...o.hero}
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Portfolio' }]}
      buttons={[
        { label: 'Start Your Website', href: '/contact/' },
        { label: 'See Pricing', href: '/iron-packages', variant: 'glass' },
      ]}
    />

    <section class="relative -mt-12 rounded-t-[44px] bg-[#fbf3ec] px-2.5 py-[88px] text-ink md:py-[120px]">
      <div class="mx-auto max-w-[1100px]">
        <div class="mx-auto max-w-[700px] text-center" data-reveal>
          <p class="text-[14px] leading-none font-semibold tracking-[3px] text-brand uppercase">{o.intro.eyebrow}</p>
          <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">{o.intro.title} <span class="font-(family-name:--font-accent) font-normal text-brand italic">{o.intro.accent}</span></h2>
          <p class="mt-4 text-[17px] leading-8 text-black/60">{o.intro.text}</p>
        </div>
        <div class="mt-12">
          <PortfolioGrid client:load projects={o.projects} />
        </div>
      </div>
    </section>

    <section class="relative -mt-12 overflow-hidden rounded-t-[44px] bg-[#181310] px-2.5 py-[88px] text-white md:py-[120px]">
      <span aria-hidden="true" class="pointer-events-none absolute -top-24 right-[8%] size-[420px] rounded-full bg-brand/20 blur-[130px]"></span>
      <div class="relative mx-auto max-w-[1100px]">
        <div class="mx-auto max-w-[680px] text-center" data-reveal>
          <p class="text-[14px] leading-none font-semibold tracking-[3px] text-brand-light uppercase">{o.steps.eyebrow}</p>
          <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">{o.steps.title} <span class="font-(family-name:--font-accent) font-normal text-brand italic">{o.steps.accent}</span></h2>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            o.steps.items.map((s, i) => (
              <div data-reveal style={`--reveal-delay:${i * 100}ms`} class="group rounded-[24px] border border-white/10 bg-white/5 p-7 transition-all duration-500 hover:-translate-y-2 hover:border-brand/60 hover:bg-brand/10">
                <span class="font-(family-name:--font-accent) text-5xl text-brand-light/60 transition-colors duration-300 group-hover:text-brand-light">0{i + 1}</span>
                <h3 class="mt-2 text-[21px] font-medium">{s.title}</h3>
                <p class="mt-3 text-[15px] leading-7 text-white/65">{s.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative -mt-12 rounded-t-[44px] bg-[#fffaf5] px-2.5 pt-[88px] pb-[130px] text-ink md:pt-[110px] md:pb-[160px]">
      <div class="mx-auto max-w-[1100px]">
        <div data-reveal class="group relative overflow-hidden rounded-[36px] bg-gradient-to-br from-brand-deep via-brand to-brand-light px-6 py-14 text-center text-white shadow-[0_40px_90px_-40px_rgba(143,66,34,0.8)] md:px-14 md:py-20">
          <span aria-hidden="true" class="absolute -top-24 -left-24 size-[320px] rounded-full bg-white/10 transition-transform duration-700 group-hover:scale-125"></span>
          <span aria-hidden="true" class="absolute -right-20 -bottom-28 size-[360px] rounded-full bg-black/10 transition-transform duration-700 group-hover:scale-125"></span>
          <div class="relative">
            <h2 class="text-[clamp(30px,4.4vw,52px)] leading-[1.1] font-medium">{o.cta.title}</h2>
            <p class="mx-auto mt-5 max-w-[620px] text-lead text-white/85">{o.cta.text}</p>
            <div class="mt-9 flex flex-wrap justify-center gap-3">
              <a href={o.cta.primary.href} class="btn btn-glass btn-lg"><span class="btn-label">{o.cta.primary.label}</span></a>
              <a href={o.cta.secondary.href} class="btn btn-glass btn-lg"><span class="btn-label">{o.cta.secondary.label}</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Reveal />
  </main>
</BaseLayout>
