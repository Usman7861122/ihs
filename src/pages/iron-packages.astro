---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerHero from '../components/sections/InnerHero.astro';
import Reveal from '../components/ui/Reveal.astro';
import { packages as o } from '../data/packages';
const check = '<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
---

<BaseLayout title="Iron Packages | Medical Marketing Plans | Iron Health Solutions" description="Pick a plan for your practice: Starter, Premium or Premium Plus. Websites, SEO, reviews, AI chat and more.">
  <main>
    <InnerHero
      eyebrow="Iron Packages"
      title="Pick a plan that's"
      accent="right for you."
      text="Three simple plans for private practices. Start with a great website, then add SEO, reviews and AI as you grow."
      image="/images/heroes/hero-iron-packages.jpg"
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Iron Packages' }]}
      buttons={[
        { label: 'Get Started', href: '/contact/', variant: 'primary' },
        { label: 'Scan My Practice', href: '/practice-scanner/', variant: 'glass' },
      ]}
      stats={[{ value: '3', label: 'simple plans' }, { value: '70+', label: 'listings managed' }, { value: '24/7', label: 'online editor' }]}
    />

    <section class="relative -mt-12 rounded-t-[44px] bg-[#fbf3ec] px-2.5 py-[88px] text-ink md:py-[120px]">
      <div class="mx-auto max-w-[1180px]">
        <div class="mx-auto max-w-[700px] text-center" data-reveal>
          <p class="text-[14px] leading-none font-semibold tracking-[3px] text-brand uppercase">Our plans</p>
          <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">Clear plans, <span class="font-(family-name:--font-accent) font-normal text-brand italic">no surprises.</span></h2>
          <p class="mt-4 text-[17px] leading-8 text-black/60">Every plan starts with a custom website built for patients. Higher plans add more ways to get found and booked.</p>
        </div>
        <div class="mt-14 grid items-stretch gap-6 lg:grid-cols-3">
          {o.plans.map((p, i) => (
            <div data-reveal style={`--reveal-delay:${i * 100}ms`} class={`group relative flex flex-col rounded-[32px] p-8 transition-all duration-500 hover:-translate-y-2 md:p-9 ${p.popular ? 'bg-[#181310] text-white shadow-[0_40px_90px_-40px_rgba(143,66,34,0.9)] ring-2 ring-brand' : 'border border-black/10 bg-white shadow-[0_24px_60px_-40px_rgba(120,60,20,0.6)] hover:shadow-[0_0_0_2px_#C96F3A,0_30px_60px_-30px_rgba(201,111,58,0.6)]'}`}>
              {p.popular && <span class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-brand-deep to-brand-light px-4 py-1.5 text-[12px] font-semibold tracking-[2px] text-white uppercase">Most popular</span>}
              <p class={`text-[13px] font-semibold tracking-[2.5px] uppercase ${p.popular ? 'text-brand-light' : 'text-brand'}`}>{p.tag}</p>
              <h3 class="mt-3 text-[34px] leading-none font-medium">{p.name}</h3>
              <p class={`mt-4 text-[16px] leading-7 ${p.popular ? 'text-white/65' : 'text-black/60'}`}>{p.text}</p>
              <a href="/contact/" class={`btn btn-lg mt-7 ${p.popular ? 'btn-glass' : 'btn-outline'}`}><span class="btn-label">Get Started</span></a>
              <ul class={`mt-8 flex-1 space-y-1 border-t pt-6 ${p.popular ? 'border-white/10' : 'border-black/10'}`}>
                {p.features.map((f) => (
                  <li class={`group/li -mx-3 flex cursor-default items-start gap-3 rounded-xl px-3 py-2 text-[15.5px] leading-6 transition-all duration-300 hover:translate-x-1.5 ${p.popular ? 'hover:bg-white/10' : 'hover:bg-brand/10'}`}>
                    <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-brand text-white transition-all duration-300 group-hover/li:scale-125 group-hover/li:shadow-[0_0_0_4px_rgba(201,111,58,0.25)]" set:html={check} />
                    <span class={`transition-colors duration-300 ${p.popular ? 'text-white/85 group-hover/li:text-white' : 'text-black/75 group-hover/li:text-black'}`}>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="relative -mt-12 overflow-hidden rounded-t-[44px] bg-[#181310] px-2.5 py-[88px] text-white md:py-[120px]">
      <span aria-hidden="true" class="pointer-events-none absolute -top-24 right-[8%] size-[420px] rounded-full bg-brand/20 blur-[130px]"></span>
      <div class="relative mx-auto max-w-[820px]">
        <div class="text-center" data-reveal>
          <p class="text-[14px] leading-none font-semibold tracking-[3px] text-brand-light uppercase">Questions</p>
          <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">Quick <span class="font-(family-name:--font-accent) font-normal text-brand italic">answers.</span></h2>
        </div>
        <div class="mt-12 space-y-3">
          {o.faqs.map((f) => (
            <details data-reveal class="group rounded-[20px] border border-white/10 bg-white/5 p-6 transition-colors open:border-brand/60 open:bg-brand/10 hover:border-brand/50">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[18px] font-medium">
                {f.q}
                <span aria-hidden="true" class="text-2xl text-brand-light transition-transform duration-300 group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-[16px] leading-7 text-white/65">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="relative -mt-12 rounded-t-[44px] bg-[#fffaf5] px-2.5 pt-[88px] pb-[130px] text-ink md:pt-[110px] md:pb-[160px]">
      <div class="mx-auto max-w-[1100px]">
        <div data-reveal class="group relative overflow-hidden rounded-[36px] bg-gradient-to-br from-brand-deep via-brand to-brand-light px-6 py-14 text-center text-white shadow-[0_40px_90px_-40px_rgba(143,66,34,0.8)] md:px-14 md:py-20">
          <span aria-hidden="true" class="absolute -top-24 -left-24 size-[320px] rounded-full bg-white/10 transition-transform duration-700 group-hover:scale-125"></span>
          <span aria-hidden="true" class="absolute -right-20 -bottom-28 size-[360px] rounded-full bg-black/10 transition-transform duration-700 group-hover:scale-125"></span>
          <div class="relative">
            <h2 class="text-[clamp(30px,4.4vw,52px)] leading-[1.1] font-medium">Not sure which plan fits?</h2>
            <p class="mx-auto mt-5 max-w-[620px] text-lead text-white/85">Run the free scan first. It shows what your practice needs, and we will suggest the right plan.</p>
            <div class="mt-9 flex flex-wrap justify-center gap-3">
              <a href="/practice-scanner/" class="btn btn-glass btn-lg"><span class="btn-label">Scan my practice</span></a>
              <a href="/services/" class="btn btn-glass btn-lg"><span class="btn-label">See all services</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <Reveal />
  </main>
</BaseLayout>
