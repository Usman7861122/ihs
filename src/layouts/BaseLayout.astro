---
import '../styles/global.css';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import CookieConsent from '../islands/CookieConsent';

interface Props {
  title: string;
  description?: string;
  image?: string; // path or full URL, 1200x630 works best
  type?: 'website' | 'article';
  noindex?: boolean;
  canonicalPath?: string; // use when a page should point at another page
  schema?: Record<string, unknown>[]; // extra JSON-LD for this page
  published?: string; // ISO date, articles only
}

const SITE = 'https://ironhealthsolutions.com';
const SITE_NAME = 'Iron Health Solutions';
const DEFAULT_DESCRIPTION =
  'Iron Health Solutions builds custom websites and runs SEO, AI search, reviews and ads for medical practices across the US.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = '/og-default.jpg',
  type = 'website',
  noindex = false,
  canonicalPath,
  schema = [],
  published,
} = Astro.props;

// One clean address per page: always the real domain, always with the trailing slash
const path = canonicalPath ?? Astro.url.pathname;
const canonical = new URL(path.endsWith('/') ? path : `${path}/`, SITE).href;
const imageUrl = new URL(image, SITE).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE}/#organization`,
  name: SITE_NAME,
  url: `${SITE}/`,
  logo: `${SITE}/images/Logo.png`,
  description: DEFAULT_DESCRIPTION,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Pasadena',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  areaServed: 'US',
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  url: `${SITE}/`,
  name: SITE_NAME,
  publisher: { '@id': `${SITE}/#organization` },
};
const jsonLd = [organization, website, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#181310" />
    <link rel="icon" type="image/png" href="/images/fe-icon.png" />
    <link rel="apple-touch-icon" href="/images/fe-icon.png" />

    <!-- Social cards (Facebook, LinkedIn, Slack, iMessage, X) -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {image === '/og-default.jpg' && <meta property="og:image:width" content="1200" />}
    {image === '/og-default.jpg' && <meta property="og:image:height" content="630" />}
    {type === 'article' && published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Preview and staging copies (for example *.vercel.app) must never be indexed -->
    <script is:inline>
      if (location.hostname !== 'ironhealthsolutions.com' && location.hostname !== 'www.ironhealthsolutions.com' && location.hostname !== 'localhost') {
        var m = document.createElement('meta');
        m.name = 'robots';
        m.content = 'noindex, nofollow';
        document.head.appendChild(m);
      }
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <CookieConsent client:load />
    <script>
      import '../scripts/video-autoplay';
    </script>
  </body>
</html>
