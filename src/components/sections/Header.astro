---
import NavMenu from '../../islands/NavMenu';
import { topbar, navItems, headerButtons } from '../../data/navigation';
---

<header class="contents">
  <!-- Top bar: fixed, 37px -->
  <div class="fixed inset-x-0 top-0 z-[99] h-(--header-topbar-h) bg-brand px-2.5">
    <a
      href={topbar.href}
      class="mx-auto flex h-full w-full max-w-(--container-topbar) items-center justify-center gap-[5px] py-2.5 text-[17px] leading-[17px] font-medium text-white"
    >
      <span>{topbar.text}</span>
      <svg aria-hidden="true" viewBox="0 0 448 512" class="size-5 fill-white" xmlns="http://www.w3.org/2000/svg">
        <path d="M313.941 216H12c-6.627 0-12 5.373-12 12v56c0 6.627 5.373 12 12 12h301.941v46.059c0 21.382 25.851 32.09 40.971 16.971l86.059-86.059c9.373-9.373 9.373-24.569 0-33.941l-86.059-86.059c-15.119-15.119-40.971-4.411-40.971 16.971V216z"></path>
      </svg>
    </a>
  </div>

  <!-- Main bar: fixed under top bar, 101.2px -->
  <div id="main-bar" class="main-bar fixed inset-x-0 top-(--header-topbar-h) z-[99] bg-surface px-2.5">
    <div class="mx-auto flex w-full max-w-(--container-header) items-center py-2.5">
      <a href="/" class="block w-60 shrink-0" aria-label="Iron Health Solutions home">
        <img
          src="/images/Logo.png"
          alt="Iron Health Solutions"
          width="802"
          height="268"
          class="block h-auto w-60"
        />
      </a>

      <div class="hidden flex-1 items-center justify-end gap-[15px] lg:flex">
        <NavMenu client:load />

        {headerButtons.map((btn) => (
          <a href={btn.href} class="btn btn-sm btn-outline">
            <span class="btn-label">{btn.label}</span>
          </a>
        ))}
      </div>

      <!-- Mobile menu button -->
      <button id="menu-toggle" type="button" class="menu-toggle ml-auto lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Mobile">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} data-nav>{item.label}</a>
            {item.children && (
              <ul class="mobile-sub">
                {item.children.map((c) => (
                  <li><a href={c.href} data-nav>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="mobile-cta">
        {headerButtons.map((btn) => (
          <a href={btn.href} class="btn btn-sm btn-outline" data-nav><span class="btn-label">{btn.label}</span></a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.classList.toggle('is-open', open);
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  document.querySelectorAll('[data-nav]').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Mark the link of the section on screen as active
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link[href^="#"], .nav-sub[href^="#"]'));
  const ids = [...new Set(links.map((l) => l.getAttribute('href')!.slice(1)))];
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const id = '#' + en.target.id;
        document.querySelectorAll('.nav-link, .nav-sub').forEach((l) =>
          l.classList.toggle('is-active', l.getAttribute('href') === id && l.classList.contains('nav-link')),
        );
        if (!list?.matches(':hover')) moveTo(current());
      });
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  ids.forEach((id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });
  // Sliding pill: one highlight glides between links
  const list = document.querySelector<HTMLElement>('.nav-list');
  const pill = list?.querySelector<HTMLElement>('.nav-pill');
  const moveTo = (el: HTMLElement | null) => {
    if (!pill) return;
    if (!el) { pill.style.opacity = '0'; return; }
    pill.style.opacity = '1';
    pill.style.width = el.offsetWidth + 'px';
    pill.style.transform = `translateX(${el.offsetLeft}px)`;
  };
  const current = () => list?.querySelector<HTMLElement>('.nav-link.is-active')?.parentElement ?? null;
  list?.querySelectorAll<HTMLElement>('.nav-item').forEach((it) => {
    it.addEventListener('mouseenter', () => moveTo(it));
    it.addEventListener('focusin', () => moveTo(it));
  });
  list?.addEventListener('mouseleave', () => moveTo(current()));
  list?.addEventListener('focusout', () => moveTo(current()));

  // Header gets a soft glass look and shadow after scrolling
  const bar = document.getElementById('main-bar');
  const onScroll = () => bar?.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
