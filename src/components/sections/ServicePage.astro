---
// Reusable service page layout, driven by a data object (see src/data/services/*)
import InnerHero from './InnerHero.astro';
import Reveal from '../ui/Reveal.astro';
const { s } = Astro.props;
const arrow = '<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
const check = '<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
---

<InnerHero
  {...s.hero}
  crumbs={s.crumbs}
  buttons={[
    { label: 'Free Consultation', href: s.cta.primary.href },
    { label: 'Scan Your Practice', href: s.cta.secondary.href, variant: 'glass' },
  ]}
/>

<!-- Intro split -->
<section class="relative -mt-12 rounded-t-[44px] bg-[#fbf3ec] px-2.5 pt-[88px] pb-[96px] text-ink md:pt-[120px] md:pb-[130px]">
  <div class="mx-auto grid max-w-[1100px] items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div data-reveal>
      <p class="flex items-center gap-3 text-[14px] leading-none font-semibold tracking-[3px] text-brand uppercase"><span aria-hidden="true" class="h-0.5 w-10 bg-brand"></span>{s.intro.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">{s.intro.title} <span class="font-(family-name:--font-accent) font-normal text-brand italic">{s.intro.accent}</span></h2>
      {s.intro.paragraphs.map((p) => <p class="mt-5 text-[17px] leading-8 text-black/60">{p}</p>)}
    </div>
    <div class="group relative" data-reveal style="--reveal-delay:120ms">
      <span aria-hidden="true" class="absolute inset-0 translate-x-4 translate-y-4 rounded-[28px] border-2 border-brand/35 transition-transform duration-500 group-hover:translate-x-6 group-hover:translate-y-6"></span>
      <div class="relative overflow-hidden rounded-[28px] shadow-[0_30px_80px_-30px_rgba(143,66,34,0.5)]">
        <img src={s.intro.image} alt={s.intro.imageAlt} loading="lazy" class="aspect-[4/3] size-full object-cover transition-transform duration-[900ms] group-hover:scale-105" />
        <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-brand-deep/35 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
      </div>
    </div>
    <div class="mt-4 grid gap-4 md:grid-cols-3 lg:col-span-2">
      {s.intro.points.map((p, i) => (
        <div data-reveal style={`--reveal-delay:${i * 100}ms`} class="group relative flex items-center gap-4 overflow-hidden rounded-[22px] border border-black/5 bg-white px-5 py-4 shadow-[0_20px_44px_-32px_rgba(143,66,34,0.55)] transition-all duration-500 hover:-translate-y-1.5 hover:border-brand/40 hover:shadow-[0_0_0_2px_#C96F3A,0_26px_50px_-26px_rgba(201,111,58,0.55)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 w-1 origin-top scale-y-0 bg-brand transition-transform duration-500 group-hover:scale-y-100"></span>
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand/12 text-brand transition-all duration-300 group-hover:scale-110 group-hover:bg-brand group-hover:text-white" set:html={check}></span>
          <p class="text-[16px] leading-snug font-medium transition-colors duration-300 group-hover:text-brand-deep">{p}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Feature cards -->
<section class="relative -mt-12 rounded-t-[44px] bg-white px-2.5 py-[88px] text-ink shadow-[0_-24px_50px_-30px_rgba(143,66,34,0.35)] md:py-[120px]">
  <div class="mx-auto max-w-[1100px]">
    <div class="mx-auto max-w-[680px] text-center" data-reveal>
      <p class="text-[14px] leading-none font-semibold tracking-[3px] text-brand uppercase">{s.features.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">{s.features.title} <span class="font-(family-name:--font-accent) font-normal text-brand italic">{s.features.accent}</span></h2>
      <p class="mt-4 text-[17px] leading-8 text-black/60">{s.features.text}</p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {s.features.cards.map((c, i) => (
        <article data-reveal style={`--reveal-delay:${i * 120}ms`} class="group relative overflow-hidden rounded-[28px] border border-black/5 bg-[#fffaf5] p-7 shadow-[0_30px_70px_-45px_rgba(143,66,34,0.6)] transition-all duration-500 hover:-translate-y-2 hover:border-brand/40 hover:bg-white hover:shadow-[0_0_0_2px_#C96F3A,0_36px_70px_-30px_rgba(201,111,58,0.55)] md:p-8">
          <span aria-hidden="true" class="absolute top-0 left-0 h-1 w-0 bg-gradient-to-r from-brand to-brand-light transition-all duration-500 group-hover:w-full"></span>
          <span class="font-(family-name:--font-accent) text-5xl text-brand/30 transition-colors duration-300 group-hover:text-brand">0{i + 1}</span>
          <h3 class="mt-2 text-[24px] leading-tight font-medium">{c.title}</h3>
          <p class="mt-3 text-[16px] leading-7 text-black/60">{c.text}</p>
          <ul class="mt-5 grid gap-2.5 border-t border-black/10 pt-5">
            {c.points.map((p) => <li class="flex items-start gap-2.5 text-[15px] text-black/75 transition-transform duration-300 group-hover:translate-x-1"><span class="mt-0.5 text-brand" set:html={check}></span>{p}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Recent work (optional) -->
{s.showcase && (
<section class="relative -mt-12 rounded-t-[44px] bg-[#fbf3ec] px-2.5 py-[88px] text-ink md:py-[120px]">
  <div class="mx-auto max-w-[1100px]">
    <div class="mx-auto max-w-[680px] text-center" data-reveal>
      <p class="text-[14px] leading-none font-semibold tracking-[3px] text-brand uppercase">{s.showcase.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">{s.showcase.title} <span class="font-(family-name:--font-accent) font-normal text-brand italic">{s.showcase.accent}</span></h2>
      <p class="mt-4 text-[17px] leading-8 text-black/60">{s.showcase.text}</p>
    </div>
    <div class="mt-14 grid gap-x-8 gap-y-14 md:grid-cols-2">
      {s.showcase.items.map((it, i) => (
        <a href={it.href ?? '/portfolio/'} data-reveal style={`--reveal-delay:${(i % 2) * 120}ms`} class="group relative block pb-2">
          <span aria-hidden="true" class="absolute -inset-3 -z-0 rounded-[40px] bg-gradient-to-br from-brand/15 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
          <div class="relative flex items-end rounded-[30px] bg-gradient-to-br from-[#f1ddcb] via-[#f7e9dc] to-[#ecc9a8]/70 p-4 pb-5 md:p-6 md:pb-7">
            <div class="relative min-w-0 flex-1 overflow-hidden rounded-[22px] border border-black/10 bg-white shadow-[0_40px_80px_-40px_rgba(60,25,5,0.65)] transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-[0_0_0_2px_#C96F3A,0_50px_90px_-40px_rgba(201,111,58,0.7)]">
              <div class="flex items-center gap-1.5 border-b border-black/10 bg-[#f3ece5] px-4 py-3">
                <span class="size-2.5 rounded-full bg-[#ff5f57]"></span><span class="size-2.5 rounded-full bg-[#febc2e]"></span><span class="size-2.5 rounded-full bg-[#28c840]"></span>
                <span class="ml-3 truncate rounded-full bg-white px-4 py-1 text-[12px] text-black/45">{it.domain}</span>
              </div>
              <div class="aspect-[16/10] overflow-hidden">
                <img src={it.image} alt={`${it.name} website`} loading="lazy" class="size-full object-cover object-top transition-transform duration-[1200ms] ease-out group-hover:scale-105" />
              </div>
            </div>
            {it.phone && (
              <div class="relative z-10 -ml-[9%] w-[23%] max-w-[130px] min-w-[78px] shrink-0 translate-y-1 transition-transform duration-500 group-hover:-translate-y-2">
                <div class="relative rounded-[14px] bg-gradient-to-b from-[#3a3a3e] via-[#1b1b1e] to-[#2c2c30] p-[2.5px] shadow-[0_28px_44px_-12px_rgba(0,0,0,0.65),0_0_0_1px_rgba(255,255,255,0.12)_inset] md:rounded-[18px]">
                  <span aria-hidden="true" class="absolute top-[20%] -left-[2px] h-[7%] w-[3px] rounded-l bg-[#2a2a2e]"></span>
                  <span aria-hidden="true" class="absolute top-[30%] -left-[2px] h-[11%] w-[3px] rounded-l bg-[#2a2a2e]"></span>
                  <span aria-hidden="true" class="absolute top-[26%] -right-[2px] h-[14%] w-[3px] rounded-r bg-[#2a2a2e]"></span>
                  <div class="relative overflow-hidden rounded-[11px] bg-black md:rounded-[15px]">
                    <div aria-hidden="true" class="flex h-[9px] items-center justify-center gap-1 bg-black md:h-[12px]"><span class="h-[2px] w-[22%] rounded-full bg-[#2c2c30]"></span><span class="size-[3px] rounded-full bg-[#26262c]"></span></div>
                    <img src={it.phone} alt={`${it.name} on mobile`} loading="lazy" class="block aspect-[9/17] w-full object-cover object-top" />
                    <div aria-hidden="true" class="h-[6px] bg-black md:h-[8px]"></div>
                    <span aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-transparent"></span>
                  </div>
                </div>
              </div>
            )}
          </div>
          <div class="relative mt-5 flex items-end justify-between gap-4 px-1">
            <div>
              <h3 class="text-[22px] leading-tight font-medium transition-colors duration-300 group-hover:text-brand">{it.name}</h3>
              <p class="mt-1 text-[15px] text-black/55">{it.specialty}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
    <div class="mt-12 text-center" data-reveal>
      <a href={s.showcase.button.href} class="btn btn-outline btn-lg"><span class="btn-label">{s.showcase.button.label}</span><span class="btn-icon" set:html={arrow}></span></a>
    </div>
  </div>
</section>
)}

<!-- Benefits + stats (dark) -->
<section class="relative -mt-12 rounded-t-[44px] bg-[#181310] px-2.5 py-[88px] text-white md:py-[120px]">
  <div class="mx-auto max-w-[1100px]">
    <div class="mx-auto max-w-[680px] text-center" data-reveal>
      <p class="text-[14px] leading-none font-semibold tracking-[3px] text-brand-light uppercase">{s.benefits.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">{s.benefits.title} <span class="font-(family-name:--font-accent) font-normal text-brand italic">{s.benefits.accent}</span></h2>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {s.benefits.cards.map((c, i) => (
        <div data-reveal style={`--reveal-delay:${i * 120}ms`} class="group rounded-[24px] border border-white/10 bg-white/5 p-7 transition-all duration-500 hover:-translate-y-2 hover:border-brand/60 hover:bg-brand/10 hover:shadow-[0_30px_60px_-30px_rgba(201,111,58,0.7)]">
          <span aria-hidden="true" class="mb-4 block h-1 w-10 rounded-full bg-brand transition-all duration-500 group-hover:w-20"></span>
          <h3 class="text-[22px] font-medium text-brand-light">{c.title}</h3>
          <p class="mt-3 text-[16px] leading-7 text-white/65">{c.text}</p>
        </div>
      ))}
    </div>
    <div class="mt-16 rounded-[28px] border border-white/10 bg-gradient-to-br from-brand/20 to-transparent p-8 md:p-12" data-reveal>
      <p class="text-center text-[clamp(22px,2.8vw,32px)] font-medium">{s.stats.title}</p>
      <dl class="mt-10 grid gap-8 md:grid-cols-3">
        {s.stats.items.map((x) => (
          <div class="group cursor-default text-center transition-transform duration-500 hover:-translate-y-1 hover:scale-105">
            <dt class="font-(family-name:--font-accent) text-6xl text-brand-light transition-colors duration-300 group-hover:text-white md:text-7xl">{x.value}</dt>
            <dd class="mx-auto mt-2 max-w-[260px] text-[15px] leading-6 text-white/65">{x.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<!-- Approach -->
<section class="relative -mt-12 overflow-hidden rounded-t-[44px] bg-gradient-to-b from-[#fbf3ec] via-[#f6e6d8] to-[#fbf3ec] px-2.5 py-[88px] text-ink md:py-[120px]">
  <span aria-hidden="true" class="pointer-events-none absolute -top-20 -left-24 size-[420px] rounded-full bg-brand/15 blur-[110px]"></span>
  <span aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 size-[460px] rounded-full bg-brand-light/30 blur-[120px]"></span>
  <span aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgba(143,66,34,0.12)_1px,transparent_1px)] bg-[length:22px_22px] opacity-60"></span>
  <div class={`relative mx-auto grid max-w-[1100px] items-center gap-12 lg:gap-16 ${s.approach.image ? 'lg:grid-cols-[1.1fr_0.9fr]' : ''}`}>
    <div>
      <div data-reveal>
        <p class="flex items-center gap-3 text-[14px] leading-none font-semibold tracking-[3px] text-brand uppercase"><span aria-hidden="true" class="h-0.5 w-10 bg-brand"></span>{s.approach.eyebrow}</p>
        <h2 class="mt-5 text-[clamp(32px,4.4vw,52px)] leading-[1.1] font-medium">{s.approach.title} <span class="font-(family-name:--font-accent) font-normal text-brand italic">{s.approach.accent}</span></h2>
      </div>
      <div class={`mt-10 grid gap-8 sm:grid-cols-2 ${s.approach.image ? '' : 'lg:grid-cols-4 lg:gap-9'}`}>
        {s.approach.items.map((c, i) => (
          <div data-reveal style={`--reveal-delay:${i * 100}ms`} class="group relative rounded-[24px] border border-white bg-gradient-to-b from-white to-[#fff6ee] p-6 pb-8 shadow-[0_26px_50px_-30px_rgba(143,66,34,0.6),inset_0_1px_0_#fff] transition-all duration-500 hover:-translate-y-2 hover:border-brand/40 hover:shadow-[0_0_0_2px_#C96F3A,0_34px_60px_-26px_rgba(201,111,58,0.6)]">
            <span aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden rounded-[24px]">
              <span class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-deep via-brand to-brand-light opacity-70 transition-opacity duration-500 group-hover:opacity-100"></span>
              <span class="absolute right-4 bottom-1 font-(family-name:--font-accent) text-[96px] leading-none text-brand/10 italic transition-all duration-500 group-hover:-translate-y-1 group-hover:text-brand/20">{i + 1}</span>
            </span>
            <span class="relative mb-4 grid size-11 place-items-center rounded-full bg-gradient-to-br from-brand to-brand-deep text-[16px] font-semibold text-white shadow-[0_10px_20px_-8px_rgba(143,66,34,0.8)] transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">{i + 1}</span>
            {i < s.approach.items.length - 1 && (
              <>
                                <span aria-hidden="true" class={`absolute top-1/2 -right-[27px] z-20 hidden size-9 -translate-y-1/2 place-items-center rounded-full border-2 border-brand/40 bg-white text-brand shadow-[0_8px_18px_-8px_rgba(143,66,34,0.6)] transition-all duration-300 group-hover:translate-x-1 group-hover:border-brand group-hover:bg-brand group-hover:text-white ${s.approach.image ? '' : 'lg:grid'}`} set:html={arrow}></span>
              </>
            )}
            {i < s.approach.items.length - 1 && (
              <span aria-hidden="true" class={`absolute -bottom-[18px] left-1/2 z-20 grid size-8 -translate-x-1/2 rotate-90 place-items-center rounded-full border-2 border-brand/40 bg-white text-brand ${s.approach.image ? 'hidden' : 'lg:hidden'} ${i % 2 === 1 ? 'sm:hidden' : ''}`} set:html={arrow}></span>
            )}
            <h3 class="text-[19px] font-medium">{c.title}</h3>
            <p class="mt-2 text-[15px] leading-7 text-black/60">{c.text}</p>
          </div>
        ))}
      </div>
    </div>
    {s.approach.image && <div class="group overflow-hidden rounded-[28px] shadow-[0_30px_80px_-30px_rgba(143,66,34,0.5)]" data-reveal>
      <img src={s.approach.image} alt={s.approach.imageAlt} loading="lazy" class="aspect-[4/3] size-full object-cover transition-transform duration-[900ms] group-hover:scale-105" />
    </div>}
  </div>
</section>

<!-- CTA card + related (light section so it does not stack with the dark footer CTA) -->
<section class="relative -mt-12 rounded-t-[44px] bg-[#fffaf5] px-2.5 pt-[88px] pb-[130px] text-ink md:pt-[110px] md:pb-[160px]">
  <div class="mx-auto max-w-[1100px]">
    <div data-reveal class="group relative overflow-hidden rounded-[36px] bg-gradient-to-br from-brand-deep via-brand to-brand-light px-6 py-14 text-center text-white shadow-[0_40px_90px_-40px_rgba(143,66,34,0.8)] md:px-14 md:py-20">
      <span aria-hidden="true" class="absolute -top-24 -left-24 size-[320px] rounded-full bg-white/10 transition-transform duration-700 group-hover:scale-125"></span>
      <span aria-hidden="true" class="absolute -right-20 -bottom-28 size-[360px] rounded-full bg-black/10 transition-transform duration-700 group-hover:scale-125"></span>
      <div class="relative">
        <h2 class="text-[clamp(30px,4.4vw,52px)] leading-[1.1] font-medium">{s.cta.title}</h2>
        <p class="mx-auto mt-5 max-w-[620px] text-lead text-white/85">{s.cta.text}</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href={s.cta.primary.href} class="btn btn-glass btn-lg"><span class="btn-label">{s.cta.primary.label}</span></a>
          <a href={s.cta.secondary.href} class="btn btn-glass btn-lg"><span class="btn-label">{s.cta.secondary.label}</span></a>
        </div>
      </div>
    </div>

    <p class="mt-14 text-center text-[13px] font-semibold tracking-[3px] text-black/45 uppercase" data-reveal>Explore more services</p>
    <div class="mt-5 flex flex-wrap justify-center gap-3" data-reveal>
      {s.related.map((r) => (
        <a href={r.href} class="btn btn-outline btn-sm"><span class="btn-label">{r.label}</span><span class="btn-icon" set:html={arrow}></span></a>
      ))}
    </div>
  </div>
</section>

<Reveal />
